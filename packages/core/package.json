{
  "name": "@ai-ui/core",
  "version": "0.3.0",
  "description": "Shared types, hooks, and utilities for AI UI components",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@ai-ui/eslint-config": "workspace:*",
    "@ai-ui/vitest-config": "workspace:*",
    "@types/react": "^18.2.45",
    "eslint": "^8.57.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^2.0.0",
    "rimraf": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
