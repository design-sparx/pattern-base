{
  "name": "@patternbase/antd",
  "version": "0.3.0",
  "description": "Ant Design implementation of AI UI components",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@patternbase/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "antd": "^5.0.0",
    "@ant-design/icons": "^5.0.0"
  },
  "devDependencies": {
    "@patternbase/eslint-config": "workspace:*",
    "@patternbase/vitest-config": "workspace:*",
    "@ant-design/icons": "^5.5.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.2.45",
    "antd": "^5.22.0",
    "eslint": "^8.57.0",
    "jsdom": "^25.0.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^2.0.0",
    "rimraf": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
